{
  "name": "arkumu-theme",
  "version": "1.0.0",
  "description": "Arkumu theme",
  "scripts": {
    "dev": "tailwindcss -i ./css/input.css -o ../static/css/output.css --watch",
    "build": "tailwindcss -i ./css/input.css -o ../static/css/output.css --minify",
    "test": "playwright test --project=chromium",
    "test:setup": "playwright test --project=setup",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ui": "playwright test --project=chromium --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "tailwindcss": "^3.3.3",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "daisyui": "^4.7.2",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
